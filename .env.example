# Copy to .env.local and fill in real values (README "Setup").

# Nutrient DWS Processor API — extraction (lib/nutrient.ts), Markdown→PDF
# conversion and digital signing of review records (lib/runs/records.ts).
NUTRIENT_API_KEY=

# SerpApi — live checks (lib/serpapi.ts, scripts/smoke-serpapi.ts, scripts/test-queries.ts)
SERPAPI_API_KEY=

# Name every new signature is made under (the decision bar's "Signing as …").
SPARKLINE_REVIEWER=
