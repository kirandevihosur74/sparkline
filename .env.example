# Copy to .env.local and fill in real values (README "Setup").

# Nutrient DWS Processor API — used by lib/nutrient.ts, scripts/smoke-nutrient.ts,
# scripts/build-docs.ts, scripts/test-extraction.ts
NUTRIENT_API_KEY=

# Nutrient Viewer API — checked by app/api/viewer-session/route.ts
# (Viewer runs in Web SDK standalone mode for the demo, so this can stay empty)
NUTRIENT_VIEWER_API_KEY=

# SerpApi — used by lib/serpapi.ts, scripts/smoke-serpapi.ts, scripts/test-queries.ts
SERPAPI_API_KEY=
